parameters:
	ignoreErrors:
		# M-ANILIST-07 (phpstan level 9 honest baseline, re-derived with the
		# tests/Stub/ host mirrors wired via phpstan.neon bootstrapFiles):
		# the entire 12-family class.notFound block (unknown MediaItem /
		# ItemRepository / Workerman\Timer / Workerman\Http\Client) is GONE —
		# stub-backed uses now analyse against the real host signatures.
		# What remains is the mixed remote-JSON shape (offsets on json_decode
		# values), intentional defensive guards whose runtime payload is
		# wider than the docblock claims, and one dead-stub return type —
		# each entry attributable to concrete sites below.
		#
		# w14L8 (register PG-167/PG-168) retired five AniListApi.php entries
		# from this baseline — the formatGraphQLErrors argument/is_array/
		# strict-comparison trio (the parameter now documents the raw mixed
		# fragment it receives and the loop guards it honestly), and the
		# four Page-offset suppressions (the reads now go through the typed
		# readPageList()/readMedia() boundary readers, so the offsets are no
		# longer reached through mixed at all).
		-
			message: '#^Cannot access offset ''english'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/AniListPlugin.php

		-
			message: '#^Cannot access offset ''extraLarge'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/AniListPlugin.php

		-
			message: '#^Cannot access offset ''large'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/AniListPlugin.php

		-
			message: '#^Cannot access offset ''native'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/AniListPlugin.php

		-
			# Mixed-JSON boundary: title { romaji english native } and
			# coverImage { large extraLarge } fragment reads in
			# buildMetadataFromEntry — every read passes through
			# optionalString()/scrubRemoteText() narrowing. (w06L5 retired the
			# second 'romaji' site: the enrichment log now reads the scrubbed
			# stored projection, not the raw entry fragment.)
			message: '#^Cannot access offset ''romaji'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/AniListPlugin.php

		-
			# The metadata lookup hook exists on host master (bfd4af98) but NOT
			# in the released v1.2.x tags: the probe is deploy-matrix defense and
			# the fallback debug-skip is live code on release hosts — phpstan
			# analyses against the modern-surface mirror in tests/Stub/, so the
			# probe "always" passes (same posture as the Timer::sleep entry).
			message: '#^Call to function method_exists\(\) with Phlix\\Media\\Library\\ItemRepository and ''findByMetadataField'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/AniListPlugin.php

		-
			# Runtime version-drift guard (workerman hosts older than the
			# v5.2.3 mirror behind tests/Stub/ lack Timer::sleep): phpstan
			# analyses against the stub, so the probe "always" passes. The
			# fallback usleep() branch is live code on old hosts — guard and
			# baseline entry both stay.
			message: '#^Call to function method_exists\(\) with ''Workerman\\\\Timer'' and ''sleep'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/HttpClient.php

		-
			# json_decode(..., true) yields array<mixed,mixed>; the declared
			# array<string,mixed> return is the GraphQL-body contract every
			# consumer relies on — boundary narrowing by declaration.
			message: '#^Method Phlix\\Plugins\\Metadata\\AniList\\HttpClient\:\:request\(\) should return array\<string, mixed\> but returns array\<mixed, mixed\>\.$#'
			identifier: return.type
			count: 1
			path: src/HttpClient.php
